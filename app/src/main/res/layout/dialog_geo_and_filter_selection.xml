<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loginBackground"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_10ssp">


        <RelativeLayout
            android:id="@+id/rlHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5ssp">


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="@dimen/_10ssp"
                android:src="@drawable/close_s_6" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/filter"
                android:textColor="@color/color_22_22_22"
                android:textSize="@dimen/_16ssp" />


        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/llBottom"
            android:layout_below="@+id/rlHeader"
            android:layout_marginStart="@dimen/_10ssp"
            android:layout_marginTop="@dimen/_10ssp"
            android:layout_marginEnd="@dimen/_10ssp"
            android:layout_marginBottom="@dimen/_10ssp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/colorWhite"
                            android:orientation="vertical"
                            android:paddingBottom="@dimen/_10ssp"
                            android:visibility="visible">


                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10ssp"
                                android:layout_marginTop="@dimen/_5ssp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/district"
                                android:textColor="@color/color_59_59_59"
                                android:textSize="@dimen/_14ssp" />

                            <RelativeLayout
                                android:id="@+id/rlDistrict"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_5ssp"
                                android:background="@drawable/voter_details_edit_text_background">


                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/etDistrict"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_35ssp"
                                    android:layout_toStartOf="@+id/ivDistrict"
                                    android:background="@null"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:gravity="center_vertical"
                                    android:hint="@string/district"
                                    android:imeOptions="actionDone"
                                    android:paddingStart="@dimen/_10ssp"
                                    android:paddingEnd="@dimen/_10ssp"
                                    android:singleLine="true"
                                    android:textColor="@color/color_22_22_22"
                                    android:textSize="@dimen/_14ssp" />


                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivDistrict"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginEnd="@dimen/_10ssp"
                                    android:src="@drawable/dropdown_arrow_h"
                                    android:tint="@color/color_22_22_22"
                                    android:visibility="gone" />

                            </RelativeLayout>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10ssp"
                                android:layout_marginTop="@dimen/_5ssp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/llg"
                                android:textColor="@color/color_59_59_59"
                                android:textSize="@dimen/_14ssp" />

                            <RelativeLayout
                                android:id="@+id/rlLLG"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_5ssp"
                                android:background="@drawable/voter_details_edit_text_background">


                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/etLLG"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_35ssp"
                                    android:layout_toStartOf="@+id/ivLLG"
                                    android:background="@null"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:gravity="center_vertical"
                                    android:hint="@string/llg"
                                    android:imeOptions="actionDone"
                                    android:paddingStart="@dimen/_10ssp"
                                    android:paddingEnd="@dimen/_10ssp"
                                    android:singleLine="true"
                                    android:textColor="@color/color_22_22_22"
                                    android:textSize="@dimen/_14ssp" />


                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivLLG"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginEnd="@dimen/_10ssp"
                                    android:src="@drawable/dropdown_arrow_h"
                                    android:tint="@color/color_22_22_22" />

                            </RelativeLayout>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10ssp"
                                android:layout_marginTop="@dimen/_5ssp"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/ward"
                                android:textColor="@color/color_59_59_59"
                                android:textSize="@dimen/_14ssp" />

                            <RelativeLayout
                                android:id="@+id/rlWard"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/_5ssp"
                                android:background="@drawable/voter_details_edit_text_background">


                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/etWard"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_35ssp"
                                    android:layout_toStartOf="@+id/ivWard"
                                    android:background="@null"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:gravity="center_vertical"
                                    android:hint="@string/ward"
                                    android:imeOptions="actionDone"
                                    android:paddingStart="@dimen/_10ssp"
                                    android:paddingEnd="@dimen/_10ssp"
                                    android:singleLine="true"
                                    android:textColor="@color/color_22_22_22"
                                    android:textSize="@dimen/_14ssp" />


                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivWard"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginEnd="@dimen/_10ssp"
                                    android:src="@drawable/dropdown_arrow_h"
                                    android:tint="@color/color_22_22_22" />

                            </RelativeLayout>

                            <LinearLayout
                                android:id="@+id/llLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5ssp"
                                android:background="@color/colorWhite"
                                android:orientation="vertical">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_10ssp"
                                    android:layout_marginTop="@dimen/_5ssp"
                                    android:fontFamily="@font/poppins_regular"
                                    android:text="@string/location"
                                    android:textColor="@color/color_59_59_59"
                                    android:textSize="@dimen/_14ssp" />

                                <RelativeLayout
                                    android:id="@+id/rlLocation"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_5ssp"
                                    android:layout_marginTop="@dimen/_5ssp"
                                    android:layout_marginEnd="@dimen/_5ssp"
                                    android:layout_marginBottom="@dimen/_10ssp"
                                    android:background="@drawable/voter_details_edit_text_background">


                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/etLocation"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/_35ssp"
                                        android:layout_toStartOf="@+id/ivLocation"
                                        android:fontFamily="@font/poppins_semibold"
                                        android:gravity="center_vertical"
                                        android:hint="@string/location"
                                        android:imeOptions="actionDone"
                                        android:paddingStart="@dimen/_10ssp"
                                        android:paddingEnd="@dimen/_10ssp"
                                        android:singleLine="true"
                                        android:textColor="@color/color_22_22_22"
                                        android:textSize="@dimen/_14ssp" />


                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivLocation"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginEnd="@dimen/_10ssp"
                                        android:src="@drawable/dropdown_arrow_h"
                                        android:tint="@color/color_22_22_22" />

                                </RelativeLayout>

                            </LinearLayout>


                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_15ssp"
                        android:background="@color/colorWhite"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5ssp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_5ssp"
                            android:src="@drawable/e_user" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10ssp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/status"
                            android:textColor="@color/color_22_22_22"
                            android:textSize="@dimen/_16ssp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStatusList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/_10ssp" />
                </LinearLayout>

            </LinearLayout>


        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/llBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_10ssp"
            android:layout_marginEnd="@dimen/_10ssp"
            android:layout_marginTop="@dimen/_10ssp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_5ssp"
                android:layout_weight="0.5"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0"
                android:padding="@dimen/_10ssp"
                android:text="@string/done"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_16ssp"
                android:theme="@style/MatButtonPrimary"
                app:cardBackgroundColor="@color/buttonColor"
                app:cornerRadius="@dimen/_20ssp"
                app:rippleColor="@color/colorWhite"
                app:strokeColor="@color/buttonColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5ssp"
                android:layout_weight="0.5"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="0"
                android:padding="@dimen/_10ssp"
                android:text="@string/clear"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_16ssp"
                android:theme="@style/MatButtonPrimary"
                android:visibility="gone"
                app:cardBackgroundColor="@color/buttonColor"
                app:cornerRadius="@dimen/_20ssp"
                app:rippleColor="@color/colorWhite"
                app:strokeColor="@color/buttonColor" />

        </LinearLayout>


    </RelativeLayout>
</layout>