<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rlHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5ssp">


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_5ssp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingLeft="@dimen/_5ssp"
                android:paddingRight="@dimen/_5ssp"
                android:src="@drawable/close_s_6" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/update_status"
                android:textColor="@color/color_22_22_22"
                android:textSize="@dimen/_18ssp" />

        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rlHeader">


            <LinearLayout
                android:id="@+id/llStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorWhite"
                android:orientation="vertical"
                android:padding="@dimen/_10ssp"
                android:visibility="visible">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10ssp"
                    android:layout_marginTop="@dimen/_15ssp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/status"
                    android:textColor="@color/color_59_59_59"
                    android:textSize="@dimen/_14ssp" />

                <RelativeLayout
                    android:id="@+id/rlStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5ssp"
                    android:background="@drawable/voter_details_edit_text_background">


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/etStatus"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35ssp"
                        android:layout_toStartOf="@+id/ivStatus"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center_vertical"
                        android:hint="@string/status"
                        android:imeOptions="actionDone"
                        android:paddingStart="@dimen/_10ssp"
                        android:paddingEnd="@dimen/_10ssp"
                        android:singleLine="true"
                        android:textColor="@color/color_22_22_22"
                        android:textSize="@dimen/_14ssp" />


                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_10ssp"
                        android:src="@drawable/dropdown_arrow_h"
                        android:tint="@color/color_22_22_22" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/llTransferredOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/llRegion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10ssp"
                            android:layout_marginTop="@dimen/_5ssp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/region"
                            android:textColor="@color/color_59_59_59"
                            android:textSize="@dimen/_14ssp" />

                        <RelativeLayout
                            android:id="@+id/rlRegion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5ssp"
                            android:background="@drawable/voter_details_edit_text_background">


                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/etRegion"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35ssp"
                                android:layout_toStartOf="@+id/ivRegion"
                                android:background="@null"
                                android:fontFamily="@font/poppins_semibold"
                                android:gravity="center_vertical"
                                android:hint="@string/region"
                                android:imeOptions="actionDone"
                                android:paddingStart="@dimen/_10ssp"
                                android:paddingEnd="@dimen/_10ssp"
                                android:singleLine="true"
                                android:textColor="@color/color_22_22_22"
                                android:textSize="@dimen/_14ssp" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivRegion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_10ssp"
                                android:src="@drawable/dropdown_arrow_h"
                                android:tint="@color/color_22_22_22" />

                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llProvince"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10ssp"
                            android:layout_marginTop="@dimen/_5ssp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/province"
                            android:textColor="@color/color_59_59_59"
                            android:textSize="@dimen/_14ssp" />

                        <RelativeLayout
                            android:id="@+id/rlNewProvince"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/_5ssp"
                            android:background="@drawable/voter_details_edit_text_background">


                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/etNewProvince"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_35ssp"
                                android:layout_toStartOf="@+id/ivNewProvince"
                                android:background="@null"
                                android:fontFamily="@font/poppins_semibold"
                                android:gravity="center_vertical"
                                android:hint="@string/province"
                                android:imeOptions="actionDone"
                                android:paddingStart="@dimen/_10ssp"
                                android:paddingEnd="@dimen/_10ssp"
                                android:singleLine="true"
                                android:textColor="@color/color_22_22_22"
                                android:textSize="@dimen/_14ssp" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivNewProvince"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_10ssp"
                                android:src="@drawable/dropdown_arrow_h"
                                android:tint="@color/color_22_22_22" />

                        </RelativeLayout>

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10ssp"
                        android:layout_marginTop="@dimen/_5ssp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/district"
                        android:textColor="@color/color_59_59_59"
                        android:textSize="@dimen/_14ssp" />

                    <RelativeLayout
                        android:id="@+id/rlDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5ssp"
                        android:background="@drawable/voter_details_edit_text_background">


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/etDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35ssp"
                            android:layout_toStartOf="@+id/ivDistrict"
                            android:background="@null"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center_vertical"
                            android:hint="@string/district"
                            android:imeOptions="actionDone"
                            android:paddingStart="@dimen/_10ssp"
                            android:paddingEnd="@dimen/_10ssp"
                            android:singleLine="true"
                            android:textColor="@color/color_22_22_22"
                            android:textSize="@dimen/_14ssp" />


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivDistrict"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_10ssp"
                            android:src="@drawable/dropdown_arrow_h"
                            android:tint="@color/color_22_22_22" />

                    </RelativeLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10ssp"
                        android:layout_marginTop="@dimen/_5ssp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/llg"
                        android:textColor="@color/color_59_59_59"
                        android:textSize="@dimen/_14ssp" />

                    <RelativeLayout
                        android:id="@+id/rlLLG"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5ssp"
                        android:background="@drawable/voter_details_edit_text_background">


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/etNewLLG"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35ssp"
                            android:layout_toStartOf="@+id/ivNewLLG"
                            android:background="@null"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center_vertical"
                            android:hint="@string/llg"
                            android:imeOptions="actionDone"
                            android:paddingStart="@dimen/_10ssp"
                            android:paddingEnd="@dimen/_10ssp"
                            android:singleLine="true"
                            android:textColor="@color/color_22_22_22"
                            android:textSize="@dimen/_14ssp" />


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivNewLLG"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_10ssp"
                            android:src="@drawable/dropdown_arrow_h"
                            android:tint="@color/color_22_22_22" />

                    </RelativeLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10ssp"
                        android:layout_marginTop="@dimen/_5ssp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/ward"
                        android:textColor="@color/color_59_59_59"
                        android:textSize="@dimen/_14ssp" />

                    <RelativeLayout
                        android:id="@+id/rlWard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5ssp"
                        android:background="@drawable/voter_details_edit_text_background">


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/etWard"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35ssp"
                            android:layout_toStartOf="@+id/ivWard"
                            android:background="@null"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center_vertical"
                            android:hint="@string/ward"
                            android:imeOptions="actionDone"
                            android:paddingStart="@dimen/_10ssp"
                            android:paddingEnd="@dimen/_10ssp"
                            android:singleLine="true"
                            android:textColor="@color/color_22_22_22"
                            android:textSize="@dimen/_14ssp" />


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivWard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_10ssp"
                            android:src="@drawable/dropdown_arrow_h"
                            android:tint="@color/color_22_22_22" />

                    </RelativeLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10ssp"
                        android:layout_marginTop="@dimen/_5ssp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/location"
                        android:textColor="@color/color_59_59_59"
                        android:textSize="@dimen/_14ssp" />

                    <RelativeLayout
                        android:id="@+id/rlLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_5ssp"
                        android:background="@drawable/voter_details_edit_text_background">


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/etNewLocation"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_35ssp"
                            android:layout_toStartOf="@+id/ivNewLocation"
                            android:background="@null"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center_vertical"
                            android:hint="@string/location"
                            android:imeOptions="actionDone"
                            android:paddingStart="@dimen/_10ssp"
                            android:paddingEnd="@dimen/_10ssp"
                            android:singleLine="true"
                            android:textColor="@color/color_22_22_22"
                            android:textSize="@dimen/_14ssp" />


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivNewLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/_10ssp"
                            android:src="@drawable/dropdown_arrow_h"
                            android:tint="@color/color_22_22_22" />

                    </RelativeLayout>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10ssp"
                    android:layout_marginTop="@dimen/_10ssp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/comment"
                    android:textColor="@color/color_59_59_59"
                    android:textSize="@dimen/_14ssp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5ssp"
                    android:background="@drawable/voter_details_edit_text_background">


                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etComment"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_35ssp"
                        android:background="@null"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center_vertical"
                        android:hint="@string/comment"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:paddingStart="@dimen/_10ssp"
                        android:paddingEnd="@dimen/_10ssp"
                        android:singleLine="true"
                        android:textColor="@color/color_22_22_22"
                        android:textSize="@dimen/_14ssp" />


                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/_25ssp"
                    android:layout_marginTop="@dimen/_25ssp"
                    android:layout_marginEnd="@dimen/_25ssp"
                    android:layout_marginBottom="@dimen/_20ssp"
                    android:background="@color/buttonColor"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/done"
                    android:textAllCaps="false"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/_16ssp" />


            </LinearLayout>


        </androidx.core.widget.NestedScrollView>


    </RelativeLayout>
</layout>
