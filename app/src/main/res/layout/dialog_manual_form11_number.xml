<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/loginBackground"
        android:orientation="vertical"
        android:padding="@dimen/_10ssp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvHeaderMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10ssp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/colorPrimary"
            android:text="@string/enter_form_11_number"
            android:textSize="@dimen/_12ssp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etForm11Number"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40ssp"
            android:layout_marginTop="@dimen/_10ssp"
            android:background="@drawable/edit_text_background"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center_vertical"
            android:hint="@string/please_enter_form_11_number"
            android:digits="0123456789MKA-#"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionDone"
            android:paddingStart="@dimen/_10ssp"
            android:paddingEnd="@dimen/_10ssp"
            android:singleLine="true"
            android:textColor="@color/color_22_22_22"
            android:textSize="@dimen/_12ssp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvForm11Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5ssp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/color_59_59_59"
            android:textSize="@dimen/_10ssp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10ssp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="@dimen/_5ssp"
                android:layout_weight="0.5"
                android:background="@color/buttonColor"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/submit"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_12ssp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/_5ssp"
                android:layout_weight="0.5"
                android:background="@color/buttonColor"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

    </LinearLayout>


</layout>
