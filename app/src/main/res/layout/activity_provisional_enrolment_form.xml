                                style="@style/form_text_views_key"
                                android:text="@string/section_no" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/etSectionNo"
                                style="@style/form_new_edit_text_fields"
                                android:digits="0123456789"
                                android:hint="@string/section_no"
                                android:imeOptions="actionNext"
                                android:inputType="number|textNoSuggestions" />


                        </LinearLayout>


                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:text="@string/lot_no" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/etLotNo"
                                style="@style/form_new_edit_text_fields"
                                android:digits="0123456789"
                                android:hint="@string/lot_no"
                                android:imeOptions="actionNext"
                                android:inputType="number|textNoSuggestions" />


                        </LinearLayout>

                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:text="@string/street_name" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/etStreetName"
                                style="@style/form_new_edit_text_fields"
                                android:hint="@string/street_name"
                                android:imeOptions="actionNext"
                                android:inputType="textCapSentences" />


                        </LinearLayout>

                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:text="@string/suburb_town_settlement" />

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/etSuburb"
                                style="@style/form_new_edit_text_fields"
                                android:hint="@string/suburb_town_settlement"
                                android:imeOptions="actionDone"
                                android:inputType="textCapSentences" />


                        </LinearLayout>


                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/_15ssp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/rlKMABioHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/voter_details_header_bg"
                        android:padding="@dimen/_5ssp">


                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvKMABioTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10ssp"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/mkaBio"
                            android:textColor="@color/voter_details_header_text"
                            android:textSize="@dimen/_16ssp" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/tvKMABioArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/_5ssp"
                            android:layout_marginEnd="@dimen/_10ssp"
                            android:src="@drawable/voter_details_header_arrow" />

                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/llKMABio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorWhite"
                        android:orientation="vertical"
                        android:padding="@dimen/_5ssp"
                        android:visibility="visible">

                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:layout_height="wrap_content"
                                android:text="@string/mkaDistrict" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/etMKADistrict"
                                style="@style/form_new_edit_text_selection_fields"
                                android:hint="@string/mkaDistrict" />

                        </LinearLayout>

                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:layout_height="wrap_content"
                                android:text="@string/mkaLlg" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/etMKALlg"
                                style="@style/form_new_edit_text_selection_fields"
                                android:hint="@string/mkaLlg" />

                        </LinearLayout>

                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:layout_height="wrap_content"
                                android:text="@string/mkaWard" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/etMKAWard"
                                style="@style/form_new_edit_text_selection_fields"
                                android:hint="@string/mkaWard" />

                        </LinearLayout>

                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:layout_height="wrap_content"
                                android:text="@string/mkaLocation" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/etMKALocation"
                                style="@style/form_new_edit_text_selection_fields"
                                android:hint="@string/mkaLocation" />

                        </LinearLayout>

                        <LinearLayout style="@style/form_text_views_layout">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/form_text_views_key"
                                android:layout_height="wrap_content"
                                android:text="@string/mkaClan" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/etMKAClan"
                                style="@style/form_new_edit_text_selection_fields"
                                android:hint="@string/mkaClan" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Phase 2: SevisPass National Digital ID Section -->
                    <LinearLayout
                        android:id="@+id/llSevisPassContainer"
                        style="@style/form_text_views_layout"
                        android:layout_marginTop="@dimen/_15ssp"
                        android:orientation="vertical"
                        android:padding="@dimen/_5ssp">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/form_text_views_key"
                            android:layout_width="match_parent"
                            android:text="SevisPass National ID (Optional)" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatEditText
                                android:id="@+id/etSevisPassId"
                                style="@style/form_new_edit_text_fields"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="Enter SevisPass ID"
                                android:imeOptions="actionDone"
                                android:inputType="textCapCharacters" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnVerifySevisPass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5ssp"
                                android:background="@color/buttonColor"
                                android:text="Verify"
                                android:textColor="@color/colorWhite"
                                android:textSize="@dimen/_12ssp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvSevisPassStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5ssp"
                            android:padding="@dimen/_4ssp"
                            android:text="Status: Not Verified"
                            android:textSize="@dimen/_12ssp"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/_25ssp"
            android:layout_marginTop="@dimen/_10ssp"
            android:layout_marginEnd="@dimen/_25ssp"
            android:layout_marginBottom="@dimen/_10ssp"
            android:background="@color/buttonColor"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_16ssp" />

        <RelativeLayout
            android:id="@+id/rlBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/colorPrimary"
            android:padding="@dimen/_5ssp"
            android:visibility="gone">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBottomData"
                style="@style/bottom_data_text_view" />


        </RelativeLayout>


    </RelativeLayout>
</layout>
