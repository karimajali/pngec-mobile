<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="downloadViewModel"
            type="com.pngelectoral.ui.viewModel.DownloadViewModel" />
    </data>


    <FrameLayout
        android:id="@+id/flParent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/llParent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/loginBackground"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:padding="@dimen/_20ssp">


                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/login_logo" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/_20ssp"
                android:paddingEnd="@dimen/_20ssp">


                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="@dimen/_20ssp"
                    android:layout_marginTop="@dimen/_50ssp"
                    android:layout_marginEnd="@dimen/_20ssp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center_horizontal"
                    android:text="@string/you_have_new_data_changes_please_click_on_download_button_to_continue_next"
                    android:textColor="@color/color_59_59_59"
                    android:textSize="@dimen/_16ssp" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:background="@drawable/shape_download">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:paddingStart="@dimen/_8ssp"
                        android:paddingTop="@dimen/_20ssp"
                        android:src="@drawable/download_ic" />
                </RelativeLayout>


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_50ssp"
                    android:layout_marginBottom="@dimen/_25ssp"
                    android:background="@color/buttonColor"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/download"
                    android:textAllCaps="false"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/_18ssp" />


            </RelativeLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rlDownloadingProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/semi_transparent"
            android:visibility="gone">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_margin="@dimen/_10ssp"
                android:background="@color/colorWhite"
                android:orientation="vertical"
                android:padding="@dimen/_5ssp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_20ssp"
                    android:indeterminateTint="@color/colorPrimary"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDownloadMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_margin="@dimen/_20ssp"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center_horizontal"
                    android:text="@string/please_wait_until_the_download_is_complete"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/_16ssp" />

                <ProgressBar
                    android:id="@+id/downloadProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10ssp"
                    android:scaleY="5" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDownloadPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10ssp"
                    android:layout_marginBottom="@dimen/_10ssp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/colorBlack"
                    android:textSize="@dimen/_9ssp" />

            </LinearLayout>


        </RelativeLayout>

    </FrameLayout>


</layout>
