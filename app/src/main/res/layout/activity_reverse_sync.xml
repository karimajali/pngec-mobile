<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="syncVotersListViewModel"
            type="com.pngelectoral.ui.viewModel.SyncVotersListViewModel" />
    </data>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loginBackground"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/rlHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50ssp"
            android:background="@color/colorPrimary">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBack"
                style="@style/back_button_image" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toStartOf="@id/btnHome"
                android:layout_toEndOf="@id/btnBack"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center_horizontal"
                android:text="@string/reverse_sync"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnHome"
                style="@style/home_button_image"
                android:layout_alignParentEnd="true" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlMainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rlHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/cardReverseSync"
                android:layout_margin="@dimen/_5ssp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5ssp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/what_record_type_do_you_wish_to_reverse"
                    android:textColor="@color/voter_details_header_text"
                    android:textSize="@dimen/_14ssp" />

                <RadioGroup
                    android:id="@+id/rgReverseSyncOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_5ssp"
                    android:layout_marginTop="@dimen/_10ssp"
                    android:layout_marginEnd="@dimen/_5ssp">

                    <RadioButton
                        android:id="@+id/rbNewAndTransferIn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_3ssp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/reverse_new_transfer_in_enrolment_records"
                        android:textColor="@color/voter_details_header_text"
                        android:textSize="@dimen/_12ssp" />

                    <RadioButton
                        android:id="@+id/rbUpdated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_3ssp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/reverse_updated_records"
                        android:textColor="@color/voter_details_header_text"
                        android:textSize="@dimen/_12ssp" />

                    <RadioButton
                        android:id="@+id/rbDeleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_3ssp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/reverse_deleted_records"
                        android:textColor="@color/voter_details_header_text"
                        android:textSize="@dimen/_12ssp" />

                    <RadioButton
                        android:id="@+id/rbAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_3ssp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/reverse_all_records"
                        android:textColor="@color/voter_details_header_text"
                        android:textSize="@dimen/_12ssp" />


                </RadioGroup>


            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardReverseSync"
                style="@style/MainButtonStyle"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/_35ssp"
                android:layout_marginEnd="@dimen/_35ssp"
                android:layout_marginBottom="@dimen/_10ssp"
                android:letterSpacing="0"
                android:padding="@dimen/_5ssp"
                android:text="@string/reverse_sync"
                android:textColor="@color/colorWhite"
                android:theme="@style/MatButtonPrimary"
                app:cardBackgroundColor="@color/buttonColor"
                app:cornerRadius="@dimen/_20ssp"
                app:rippleColor="@color/colorWhite"
                app:strokeColor="@color/buttonColor" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlNoContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rlHeader"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/no_data_available_to_sync"
                android:textColor="@color/color_22_22_22"
                android:textSize="@dimen/_16ssp" />


        </RelativeLayout>


    </RelativeLayout>


</layout>
