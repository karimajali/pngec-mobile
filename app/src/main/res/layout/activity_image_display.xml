<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="imageDisplayViewModel"
            type="com.pngelectoral.ui.viewModel.ImageDisplayViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rlTopBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50ssp"
            android:background="@color/colorPrimary">

            <!--            <androidx.appcompat.widget.AppCompatButton-->
            <!--                android:id="@+id/btnBack"-->
            <!--                style="@style/back_button"-->
            <!--                 />-->

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBack"
                style="@style/back_button_image" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toStartOf="@id/btnHome"
                android:layout_toEndOf="@id/btnBack"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center_horizontal"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold" />

            <!--            <androidx.appcompat.widget.AppCompatImageView-->
            <!--                android:id="@+id/btnHome"-->
            <!--                style="@style/home_button"-->
            <!--                android:layout_alignParentEnd="true" />-->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnHome"
                style="@style/home_button_image"
                android:layout_alignParentEnd="true" />


        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCapturedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/rlBottomView"
            android:layout_below="@+id/rlTopBar"
            android:layout_margin="@dimen/_25ssp"
            android:scaleType="centerCrop" />

        <RelativeLayout
            android:id="@+id/rlBottomView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60ssp"
            android:layout_alignParentBottom="true"
            android:background="#323234"
            android:padding="@dimen/_10ssp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="@dimen/_10ssp"
                android:background="@color/buttonColor"
                android:fontFamily="@font/poppins_semibold"
                android:padding="@dimen/_5ssp"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_16ssp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReCapture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="@dimen/_10ssp"
                android:background="@color/buttonColor"
                android:fontFamily="@font/poppins_semibold"
                android:padding="@dimen/_5ssp"
                android:text="@string/recapture"
                android:textAllCaps="false"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_16ssp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlBottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/colorPrimary"
            android:padding="@dimen/_5ssp">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBottomData"
                style="@style/bottom_data_text_view" />


        </RelativeLayout>


    </RelativeLayout>
</layout>
